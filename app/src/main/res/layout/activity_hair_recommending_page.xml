<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingBottom="24dp">

        <!-- 1. 상단 로고 이미지 -->
        <ImageView
            android:id="@+id/headerLogoImageView"
            android:layout_width="403dp"
            android:layout_height="114dp"
            android:layout_marginTop="20dp"
            android:contentDescription="앱 로고"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/anotherlogo4" /> <!-- 본인의 로고 파일명으로 유지됨 -->

        <!-- 2. 헤어스타일 이미지 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/imageCardView"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLogoImageView">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/hairstyleImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="추천 헤어스타일 이미지"
                    android:background="#E0E0E0"
                    tools:srcCompat="@tools:sample/avatars" />

                <ProgressBar
                    android:id="@+id/aiLoadingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. 추천 스타일 이름 -->
        <TextView
            android:id="@+id/hairstyleNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="추천 스타일: 분석 중..."
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageCardView" />

        <!-- 4. 스타일링 난이도 -->
        <LinearLayout
            android:id="@+id/difficultyLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hairstyleNameTextView">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="스타일링 난이도: "
                android:textColor="#666666"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/starRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐⭐⭐"
                android:textColor="#FFD700"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 5. 일치율 설명 -->
        <TextView
            android:id="@+id/matchDescriptionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="얼굴형을 분석하고 있습니다..."
            android:textColor="#333333"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/difficultyLayout" />

        <!-- 6. 일치율 프로그레스바 -->
        <ProgressBar
            android:id="@+id/matchProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="280dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/matchDescriptionTextView" />

        <!-- 7. 버튼 영역 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/matchProgressBar">

            <!-- AI 헤어스타일 적용하기 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyAIHairstyle"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:background="#FF5722"
                android:text="⚡ AI 헤어스타일 적용하기"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ★ 새로 추가된 원본/AI 토글 버튼 (초기엔 숨김 처리됨) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleImage"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:background="#4CAF50"
                android:text="👀 원본 사진 보기"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 저장 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1E88E5"
                android:text="저장"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 히스토리 보기 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1E88E5"
                android:text="저장한 히스토리 보기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 확인 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1E88E5"
                android:text="확인"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 스타일 인기순위 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStyleRanking"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#9E9E9E"
                android:text="📊 이번주 스타일 인기순위"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>